JWT_SECRET=
JWT_EXPIRATION=
JWT_COOKIE_EXPIRES=

# En docker-compose, DB_HOST siempre es "mysql" (nombre del servicio en la red interna)
DB_HOST=mysql
DB_USER=TU_USUARIO
DB_PASSWORD=TU_CONTRASEÑA
DB_NAME=labvirtual

# Solo lo usa el servicio mysql de docker-compose para inicializar la DB
MYSQL_ROOT_PASSWORD=

# Secreto compartido entre la API (Node, en la VPS) y bridge-agent/ (on-prem).
# Generar con: openssl rand -hex 32
BRIDGE_TOKEN=

# API key para el endpoint de ingesta de telemetría (POST /api/telemetry/*),
# la usa el script que extrae los datos del DTU y el propio bridge-agent.
# Generar con: openssl rand -hex 32
INGEST_API_KEY=

# Solo las usa bridge-agent/ (no viajan al navegador ni a la VPS)
ESP32_RELAY_WS_URL=ws://10.40.131.223:81/
ESP32_SENSOR_WS_URL=ws://10.40.131.230:81/