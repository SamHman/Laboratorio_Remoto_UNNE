JWT_SECRET=
JWT_EXPIRATION=
JWT_COOKIE_EXPIRES=

# En docker-compose, DB_HOST siempre es "mysql" (nombre del servicio en la red interna)
DB_HOST=mysql
DB_USER=TU_USUARIO
DB_PASSWORD=TU_CONTRASEÑA
DB_NAME=labvirtual

# Solo lo usa el servicio mysql de docker-compose para inicializar la DB
MYSQL_ROOT_PASSWORD=

# Secreto compartido entre la API (Node, en la VPS) y bridge-agent/ (on-prem).
# Generar con: openssl rand -hex 32
BRIDGE_TOKEN=

# API key para el endpoint de ingesta de telemetría (POST /api/telemetry/*),
# la usa el script que extrae los datos del DTU y el propio bridge-agent.
# Generar con: openssl rand -hex 32
INGEST_API_KEY=

# Solo las usa bridge-agent/ (no viajan al navegador ni a la VPS)
ESP32_RELAY_WS_URL=ws://10.40.131.223:81/
ESP32_SENSOR_WS_URL=ws://10.40.131.230:81/

# Sync del Google Sheet "DataLogger ESP32 - UNNE" -> tabla datos_irradiancia
# (app/services/irradianciaSync.js, corre dentro del propio proceso node).
# GOOGLE_SHEETS_KEY_FILE apunta al JSON de una cuenta de servicio de Google Cloud
# con permiso de LECTURA sobre el Sheet (compartir el Sheet con su client_email).
# El archivo NUNCA se commitea (carpeta credentials/ está en .gitignore) — copiarlo
# a mano en cada máquina que corra esto (local y VPS).
GOOGLE_SHEETS_KEY_FILE=./credentials/google-sheets-irradiancia.json
GOOGLE_SHEETS_IRRADIANCIA_ID=
GOOGLE_SHEETS_IRRADIANCIA_GID=0
IRRADIANCIA_POLL_INTERVAL_MS=60000